/// Une ligne par contrat de freq. Source des expositions, sinistres déclarés et segments.
table Contrats
	lineageTag: 9d6dac2d-7f37-53ba-b76d-6a94fd1ebd68

	/// Nombre de contrats dans le contexte de filtre courant.
	measure 'Nombre de contrats' = COALESCE(COUNTROWS(Contrats), 0)
		formatString: #,0
		displayFolder: Portefeuille
		lineageTag: e68ffc23-8040-549e-a3b9-037d7f4668c3

	/// Durée totale assurée, en années. Ne pas additionner après une jointure au grain sinistre.
	measure 'Exposition annees' = SUM(Contrats[Exposure])
		formatString: #,0.00
		displayFolder: Portefeuille
		lineageTag: 95171ca9-e081-5510-9673-ae37a0cc0866

	/// Sinistres déclarés dans freq ; sert à la fréquence.
	measure 'Sinistres declares' = SUM(Contrats[ClaimNb])
		formatString: #,0
		displayFolder: Portefeuille
		lineageTag: ab95465d-6d07-558f-a1b6-5634524c60f0

	/// Ratio des sommes : sinistres pour 100 années, et non pourcentage de contrats.
	measure 'Frequence pour 100 annees' = 100 * DIVIDE([Sinistres declares], [Exposition annees])
		formatString: 0.00
		displayFolder: Portefeuille
		lineageTag: b2646116-6a9b-5103-b34c-8a5f41bf295e

	/// Référence sur tous les contrats, indépendante des filtres de segments.
	measure 'Frequence portefeuille' = CALCULATE([Frequence pour 100 annees], REMOVEFILTERS(Contrats))
		formatString: 0.00
		displayFolder: Portefeuille
		lineageTag: ad349310-e735-57f5-8f8c-3d524d3535ab

	measure 'Contrats sinistres' = COALESCE(CALCULATE(COUNTROWS(Contrats), KEEPFILTERS(Contrats[ClaimNb] > 0)), 0)
		formatString: #,0
		displayFolder: Qualite
		lineageTag: c00543da-b1d6-5014-8000-8ff1ca25084c

	measure 'Contrats sans montant' = COALESCE(CALCULATE(COUNTROWS(Contrats), KEEPFILTERS(Contrats[Status] = "Montant non retrouvé")), 0)
		formatString: #,0
		displayFolder: Qualite
		lineageTag: 4c833793-c9e6-5c47-ac6d-92a199b17386

	/// Part des contrats sinistrés absents de sev. Le contrat avec un écart de nombre est suivi séparément.
	measure 'Part sans montant' = DIVIDE([Contrats sans montant], [Contrats sinistres])
		formatString: 0.00%
		displayFolder: Qualite
		lineageTag: e6f014b5-3fed-597f-a02a-c19de4ea167e

	measure 'Contrats nombre different' = COALESCE(CALCULATE(COUNTROWS(Contrats), KEEPFILTERS(Contrats[Status] = "Nombre différent")), 0)
		formatString: #,0
		displayFolder: Qualite
		lineageTag: a1b1fd24-5721-586c-ad10-8998944a49bb

	measure 'Sinistres observes' = COALESCE(COUNTROWS(Sinistres), 0)
		formatString: #,0
		displayFolder: Couts observes
		lineageTag: 2861e07e-a754-5599-943c-dba5625ac330

	/// Somme des seuls montants rapprochés. Aucune imputation des coûts absents.
	measure 'Montant observe' = SUM(Sinistres[ClaimAmount])
		formatString: #,0.00 "€"
		displayFolder: Couts observes
		lineageTag: 91c04324-0687-50f1-a9ea-2a693c6a747c

	measure 'Cout moyen observe' = DIVIDE([Montant observe], [Sinistres observes])
		formatString: #,0.00 "€"
		displayFolder: Couts observes
		lineageTag: 34604e6d-f054-5076-8c1f-08f2c1c43704

	/// Médiane des montants individuels, pas des totaux par contrat.
	measure 'Cout median observe' = MEDIAN(Sinistres[ClaimAmount])
		formatString: #,0.00 "€"
		displayFolder: Couts observes
		lineageTag: 3ddeb81f-37b5-5b6f-bd4a-d366122e7f36

	measure 'Cout observe par annee' = DIVIDE([Montant observe], [Exposition annees])
		formatString: #,0.00 "€"
		displayFolder: Couts observes
		lineageTag: 973bae68-d29f-5b0e-a67f-26d3639e76c5

	measure 'Plus gros sinistre' = MAX(Sinistres[ClaimAmount])
		formatString: #,0.00 "€"
		displayFolder: Couts observes
		lineageTag: 59fd5303-2bf3-5af9-85db-e27b1d192cfa

	measure 'Part du plus gros sinistre' = DIVIDE([Plus gros sinistre], [Montant observe])
		formatString: 0.00%
		displayFolder: Couts observes
		lineageTag: 2db39e96-d67f-52ec-bc30-4fece7c01e34

	/// Diagnostic : retirer un seul montant maximal dans le contexte courant. Aucune ligne source supprimée.
	measure 'Moyenne sans le plus gros' = IF([Sinistres observes] > 1, DIVIDE([Montant observe] - [Plus gros sinistre], [Sinistres observes] - 1))
		formatString: #,0.00 "€"
		displayFolder: Couts observes
		lineageTag: 962741b4-4a99-5247-9045-571e988912c8

	measure 'Contrats orphelins' = COALESCE(DISTINCTCOUNT(Orphelins[IDpol]), 0)
		formatString: #,0
		displayFolder: Orphelins - source complete
		lineageTag: 91073cbf-262c-5b87-8186-c8dac4f1609c

	measure 'Lignes orphelines' = COALESCE(COUNTROWS(Orphelins), 0)
		formatString: #,0
		displayFolder: Orphelins - source complete
		lineageTag: c1b6aa76-08f6-5555-b5b7-60dfea41df09

	measure 'Montant orphelin' = SUM(Orphelins[ClaimAmount])
		formatString: #,0.00 "€"
		displayFolder: Orphelins - source complete
		lineageTag: b9d95808-117e-5002-9994-b79f33431efe

	/// Critères exploratoires : 10000 contrats, 1000 années et fréquence +20% par rapport au portefeuille. Pas un test statistique.
	measure 'Priorite exploration' = IF([Nombre de contrats] >= 10000 && [Exposition annees] >= 1000 && [Frequence pour 100 annees] >= 1.2 * [Frequence portefeuille], "À approfondir", "")
		displayFolder: Exploration
		lineageTag: 05b5b87c-4a85-5555-b2d6-02a4c8664aec

	/// Masque uniquement la fréquence du visuel sous 1000 années d’exposition ; les contrats restent dans le modèle.
	measure 'Frequence affichable' = IF([Exposition annees] >= 1000, [Frequence pour 100 annees])
		formatString: 0.00
		displayFolder: Exploration
		lineageTag: 0a465d59-e265-5c88-b9fb-91997f339f36

	/// Affichage des sous-groupes avec au moins 1000 contrats et 500 années. Seuils de lecture, pas un test.
	measure 'Frequence age bonus' = IF([Nombre de contrats] >= 1000 && [Exposition annees] >= 500, [Frequence pour 100 annees])
		formatString: 0.00
		displayFolder: Exploration
		lineageTag: 612b4860-8990-5c0d-bc28-953fbade398f

	measure 'Rang region sinistres' = RANKX(ALLSELECTED(Contrats[Region]), [Sinistres declares], , DESC, DENSE)
		formatString: #,0
		displayFolder: Exploration
		lineageTag: 7368aa75-e6ac-58bc-9f20-adce0e1addc4

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Contrats R24' = CALCULATE([Nombre de contrats], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: #,0
		displayFolder: Investigations
		lineageTag: ac533324-5249-5f47-87ba-3f90dc12d9de

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Sinistres R24' = CALCULATE([Sinistres declares], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: #,0
		displayFolder: Investigations
		lineageTag: ed90cd68-028b-52c4-86f8-086503434284

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Exposition R24' = CALCULATE([Exposition annees], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: #,0.00
		displayFolder: Investigations
		lineageTag: 441c176c-9e69-5a40-b682-7f2e19079997

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Frequence R24' = CALCULATE([Frequence pour 100 annees], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 6ae0c4a8-5c01-5c51-9dd2-5de5520351b2

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Sans montant R24' = CALCULATE([Part sans montant], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: 0.00%
		displayFolder: Investigations
		lineageTag: 2a8f8823-d0e0-5cde-a377-8fcb348cf27e

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Montant R24' = CALCULATE([Montant observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: #,0 "€"
		displayFolder: Investigations
		lineageTag: 8d98bb9c-d1a2-5f4e-978d-d365788d50c7

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Moyenne R24' = CALCULATE([Cout moyen observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: 24ec3534-8dce-5ce1-97c3-77c54de2f83e

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Mediane R24' = CALCULATE([Cout median observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: 45dc2b0e-e6b3-5d3f-aab2-4f7a553f5003

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Moyenne sans maximum R24' = CALCULATE([Moyenne sans le plus gros], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: 34f7de91-7097-58db-8f1d-327c225610be

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Poids maximum R24' = CALCULATE([Part du plus gros sinistre], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: 0.00%
		displayFolder: Investigations
		lineageTag: aa2d75c4-e234-58a7-abe3-c24d51f9600f

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence R24 sans B12 zero' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0)))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 833b3262-4a09-58d8-be7b-62476bedb008

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence R24 sensibilite combinee' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0) && Contrats[Exposure] > 0.1))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R24")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: c7bd97b6-4c84-5398-9e04-76a31355f223

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Contrats hors R24' = CALCULATE([Nombre de contrats], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: #,0
		displayFolder: Investigations
		lineageTag: 44d92db2-1dec-5d41-8cea-fdab137887ad

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Sinistres hors R24' = CALCULATE([Sinistres declares], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: #,0
		displayFolder: Investigations
		lineageTag: 596c1cab-fdee-53c8-9d7d-beac898600ba

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Exposition hors R24' = CALCULATE([Exposition annees], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: #,0.00
		displayFolder: Investigations
		lineageTag: 1b259827-dcbd-50ef-99f7-5a5708017b40

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Frequence hors R24' = CALCULATE([Frequence pour 100 annees], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 481adf2b-7735-59ab-a3b6-293e7746b01f

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Sans montant hors R24' = CALCULATE([Part sans montant], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: 0.00%
		displayFolder: Investigations
		lineageTag: 4362000d-5089-5be4-8864-708ef555b66d

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Montant hors R24' = CALCULATE([Montant observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: #,0 "€"
		displayFolder: Investigations
		lineageTag: a7278c06-6b40-512f-8030-dca7223d7582

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Moyenne hors R24' = CALCULATE([Cout moyen observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: d5f8aa10-2ffb-5b0b-b520-dfee27591d26

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Mediane hors R24' = CALCULATE([Cout median observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: f7674ae7-2f76-5bb3-9bc0-f66783b425a3

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Moyenne sans maximum hors R24' = CALCULATE([Moyenne sans le plus gros], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: 3d603a97-6866-51ac-9275-967f824d2050

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Poids maximum hors R24' = CALCULATE([Part du plus gros sinistre], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: 0.00%
		displayFolder: Investigations
		lineageTag: a4e87d97-17ef-5d96-bebd-7ae9a616d6d8

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence hors R24 sans B12 zero' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0)))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 7a37ca97-f120-5535-8211-bbb70b1797cf

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence hors R24 sensibilite combinee' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0) && Contrats[Exposure] > 0.1))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R24")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 2d3283eb-e1d4-5d8f-8345-ae054d51fd82

	/// Chaque côté doit avoir 1000 contrats et 500 années. Seuil de lecture, pas test de significativité.
	measure 'Comparaison lisible R24' = IF([Contrats R24] >= 1000 && [Exposition R24] >= 500 && [Contrats hors R24] >= 1000 && [Exposition hors R24] >= 500, 1, 0)
		formatString: 0
		displayFolder: Investigations
		lineageTag: 58e78faf-6216-55ff-be9d-c0c5a6d7b4d0

	/// Une paire absente est masquée des graphiques, jamais remplacée par zéro.
	measure 'Frequence comparable R24' = IF([Comparaison lisible R24] = 1, [Frequence R24])
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: fd971354-36e7-538d-bb69-70fd90e25996

	/// Une paire absente est masquée des graphiques, jamais remplacée par zéro.
	measure 'Frequence comparable hors R24' = IF([Comparaison lisible R24] = 1, [Frequence hors R24])
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 3b901ee7-44af-599c-ac81-20a261ac8fe2

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Contrats R11' = CALCULATE([Nombre de contrats], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R11")
		formatString: #,0
		displayFolder: Investigations
		lineageTag: 274dbf5c-5df5-5186-93d0-a5a20e5e4b46

