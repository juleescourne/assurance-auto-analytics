		lineageTag: 6185eabf-a274-5f9d-b7ce-0f43660b32c3

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence R11 sans B12 zero' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0)))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R11")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 3bdcad5a-599f-5ded-83ea-16487ae12e6d

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence R11 sensibilite combinee' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0) && Contrats[Exposure] > 0.1))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] = "R11")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 6837d954-9abe-5496-a5b4-92f5b5282809

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Contrats hors R11' = CALCULATE([Nombre de contrats], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: #,0
		displayFolder: Investigations
		lineageTag: 79a94555-0688-5c65-8f67-9e2446ba1b6e

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Sinistres hors R11' = CALCULATE([Sinistres declares], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: #,0
		displayFolder: Investigations
		lineageTag: 8fc5d6cd-c999-59c1-807e-b82edda6babd

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Exposition hors R11' = CALCULATE([Exposition annees], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: #,0.00
		displayFolder: Investigations
		lineageTag: 5e72ec80-64c7-503b-8091-536cc37005f8

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Frequence hors R11' = CALCULATE([Frequence pour 100 annees], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 050ba62b-9cea-587f-9ff6-1a3c1256918a

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Sans montant hors R11' = CALCULATE([Part sans montant], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: 0.00%
		displayFolder: Investigations
		lineageTag: 72a54a79-e85b-5340-9355-802b646ecb28

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Montant hors R11' = CALCULATE([Montant observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: #,0 "€"
		displayFolder: Investigations
		lineageTag: 8b37f1ce-6de3-5d68-a303-101065c0be66

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Moyenne hors R11' = CALCULATE([Cout moyen observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: 56d1ffce-5b98-544a-bf97-f6a1a5c72a82

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Mediane hors R11' = CALCULATE([Cout median observe], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: 64fd5ff8-29a0-5285-a35b-b300efbcec9d

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Moyenne sans maximum hors R11' = CALCULATE([Moyenne sans le plus gros], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: #,0.00 "€"
		displayFolder: Investigations
		lineageTag: 7657b112-2f46-53e3-b95e-aef5b18b5c09

	/// Région fixée ; les autres filtres et les tranches restent actifs. Hors région exclut la région étudiée.
	measure 'Poids maximum hors R11' = CALCULATE([Part du plus gros sinistre], REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: 0.00%
		displayFolder: Investigations
		lineageTag: d0ca8b0b-1a2f-5b2b-b598-b3c57edd702c

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence hors R11 sans B12 zero' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0)))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: b988256e-4b56-53e8-bc2a-aaf1ea5255b8

	/// Scénario de sensibilité uniquement ; les données sources restent entières.
	measure 'Frequence hors R11 sensibilite combinee' = CALCULATE(CALCULATE([Frequence pour 100 annees], KEEPFILTERS(FILTER(Contrats, NOT(Contrats[VehBrand] = "B12" && Contrats[VehAge] = 0) && Contrats[Exposure] > 0.1))), REMOVEFILTERS(Contrats[Region], Contrats[GroupeRegion]), Contrats[Region] <> "R11")
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: e1600a27-2783-5fc9-b3c2-12adb6ab4ee4

	/// Chaque côté doit avoir 1000 contrats et 500 années. Seuil de lecture, pas test de significativité.
	measure 'Comparaison lisible R11' = IF([Contrats R11] >= 1000 && [Exposition R11] >= 500 && [Contrats hors R11] >= 1000 && [Exposition hors R11] >= 500, 1, 0)
		formatString: 0
		displayFolder: Investigations
		lineageTag: d66b09bc-cc12-5703-9a47-3bc159e26f43

	/// Une paire absente est masquée des graphiques, jamais remplacée par zéro.
	measure 'Frequence comparable R11' = IF([Comparaison lisible R11] = 1, [Frequence R11])
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 0fbc2169-9c25-5091-bc76-38b14e21b956

	/// Une paire absente est masquée des graphiques, jamais remplacée par zéro.
	measure 'Frequence comparable hors R11' = IF([Comparaison lisible R11] = 1, [Frequence hors R11])
		formatString: 0.00
		displayFolder: Investigations
		lineageTag: 68e8dea4-0cf8-59c9-b03c-744a8c55076b

