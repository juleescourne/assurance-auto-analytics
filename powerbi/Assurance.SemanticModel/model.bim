        ],
        "partitions": [
          {
            "name": "Contrats",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DossierDonnees & \"\\contrats.csv\"), [Delimiter=\";\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Entetes, {{\"IDpol\", Int64.Type}, {\"ClaimNb\", Int64.Type}, {\"Exposure\", type number}, {\"Area\", type text}, {\"VehPower\", Int64.Type}, {\"VehAge\", Int64.Type}, {\"DrivAge\", Int64.Type}, {\"BonusMalus\", Int64.Type}, {\"VehBrand\", type text}, {\"VehGas\", type text}, {\"Density\", Int64.Type}, {\"Region\", type text}, {\"Status\", type text}, {\"TrancheAgeConducteur\", type text}, {\"TrancheAgeVehicule\", type text}, {\"TrancheBonusMalus\", type text}, {\"TranchePuissance\", type text}, {\"TrancheDensite\", type text}, {\"ContratSinistre\", type logical}, {\"SansMontant\", type logical}, {\"GroupeMarque\", type text}, {\"GroupeVehicule\", type text}, {\"GroupeConducteur\", type text}, {\"GroupeRegion\", type text}, {\"TrancheExposition\", type text}, {\"Ordre_TrancheAgeConducteur\", Int64.Type}, {\"Ordre_TrancheAgeVehicule\", Int64.Type}, {\"Ordre_TrancheBonusMalus\", Int64.Type}, {\"Ordre_TranchePuissance\", Int64.Type}, {\"Ordre_TrancheDensite\", Int64.Type}, {\"Ordre_TrancheExposition\", Int64.Type}}, \"en-US\")",
                "in",
                "    Types"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Nombre de contrats",
            "expression": "COALESCE(COUNTROWS(Contrats), 0)",
            "formatString": "#,0",
            "displayFolder": "Portefeuille",
            "description": "Nombre de contrats dans le contexte de filtre courant.",
            "lineageTag": "e68ffc23-8040-549e-a3b9-037d7f4668c3"
          },
          {
            "name": "Exposition annees",
            "expression": "SUM(Contrats[Exposure])",
            "formatString": "#,0.00",
            "displayFolder": "Portefeuille",
            "description": "Durée totale assurée, en années. Ne pas additionner après une jointure au grain sinistre.",
            "lineageTag": "95171ca9-e081-5510-9673-ae37a0cc0866"
          },
          {
            "name": "Sinistres declares",
            "expression": "SUM(Contrats[ClaimNb])",
            "formatString": "#,0",
            "displayFolder": "Portefeuille",
            "description": "Sinistres déclarés dans freq ; sert à la fréquence.",
            "lineageTag": "ab95465d-6d07-558f-a1b6-5634524c60f0"
          },
          {
            "name": "Frequence pour 100 annees",
            "expression": "100 * DIVIDE([Sinistres declares], [Exposition annees])",
            "formatString": "0.00",
            "displayFolder": "Portefeuille",
            "description": "Ratio des sommes : sinistres pour 100 années, et non pourcentage de contrats.",
            "lineageTag": "b2646116-6a9b-5103-b34c-8a5f41bf295e"
          },
          {
            "name": "Frequence portefeuille",
            "expression": "CALCULATE([Frequence pour 100 annees], REMOVEFILTERS(Contrats))",
            "formatString": "0.00",
            "displayFolder": "Portefeuille",
            "description": "Référence sur tous les contrats, indépendante des filtres de segments.",
            "lineageTag": "ad349310-e735-57f5-8f8c-3d524d3535ab"
          },
          {
            "name": "Contrats sinistres",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Contrats), KEEPFILTERS(Contrats[ClaimNb] > 0)), 0)",
            "formatString": "#,0",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "c00543da-b1d6-5014-8000-8ff1ca25084c"
          },
          {
            "name": "Contrats sans montant",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Contrats), KEEPFILTERS(Contrats[Status] = \"Montant non retrouvé\")), 0)",
            "formatString": "#,0",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "4c833793-c9e6-5c47-ac6d-92a199b17386"
          },
          {
            "name": "Part sans montant",
            "expression": "DIVIDE([Contrats sans montant], [Contrats sinistres])",
            "formatString": "0.00%",
            "displayFolder": "Qualite",
            "description": "Part des contrats sinistrés absents de sev. Le contrat avec un écart de nombre est suivi séparément.",
            "lineageTag": "e6f014b5-3fed-597f-a02a-c19de4ea167e"
          },
          {
            "name": "Contrats nombre different",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Contrats), KEEPFILTERS(Contrats[Status] = \"Nombre différent\")), 0)",
            "formatString": "#,0",
            "displayFolder": "Qualite",
            "description": "",
            "lineageTag": "a1b1fd24-5721-586c-ad10-8998944a49bb"
          },
          {
            "name": "Sinistres observes",
            "expression": "COALESCE(COUNTROWS(Sinistres), 0)",
            "formatString": "#,0",
            "displayFolder": "Couts observes",
            "description": "",
            "lineageTag": "2861e07e-a754-5599-943c-dba5625ac330"
          },
          {
            "name": "Montant observe",
            "expression": "SUM(Sinistres[ClaimAmount])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Couts observes",
            "description": "Somme des seuls montants rapprochés. Aucune imputation des coûts absents.",
            "lineageTag": "91c04324-0687-50f1-a9ea-2a693c6a747c"
          },
          {
            "name": "Cout moyen observe",
            "expression": "DIVIDE([Montant observe], [Sinistres observes])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Couts observes",
            "description": "",
            "lineageTag": "34604e6d-f054-5076-8c1f-08f2c1c43704"
          },
          {
            "name": "Cout median observe",
            "expression": "MEDIAN(Sinistres[ClaimAmount])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Couts observes",
            "description": "Médiane des montants individuels, pas des totaux par contrat.",
            "lineageTag": "3ddeb81f-37b5-5b6f-bd4a-d366122e7f36"
          },
          {
            "name": "Cout observe par annee",
            "expression": "DIVIDE([Montant observe], [Exposition annees])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Couts observes",
            "description": "",
            "lineageTag": "973bae68-d29f-5b0e-a67f-26d3639e76c5"
          },
          {
            "name": "Plus gros sinistre",
            "expression": "MAX(Sinistres[ClaimAmount])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Couts observes",
            "description": "",
            "lineageTag": "59fd5303-2bf3-5af9-85db-e27b1d192cfa"
          },
          {
            "name": "Part du plus gros sinistre",
            "expression": "DIVIDE([Plus gros sinistre], [Montant observe])",
            "formatString": "0.00%",
            "displayFolder": "Couts observes",
            "description": "",
            "lineageTag": "2db39e96-d67f-52ec-bc30-4fece7c01e34"
          },
          {
            "name": "Moyenne sans le plus gros",
            "expression": "IF([Sinistres observes] > 1, DIVIDE([Montant observe] - [Plus gros sinistre], [Sinistres observes] - 1))",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Couts observes",
            "description": "Diagnostic : retirer un seul montant maximal dans le contexte courant. Aucune ligne source supprimée.",
            "lineageTag": "962741b4-4a99-5247-9045-571e988912c8"
          },
          {
            "name": "Contrats orphelins",
            "expression": "COALESCE(DISTINCTCOUNT(Orphelins[IDpol]), 0)",
            "formatString": "#,0",
            "displayFolder": "Orphelins - source complete",
            "description": "",
            "lineageTag": "91073cbf-262c-5b87-8186-c8dac4f1609c"
          },
          {
            "name": "Lignes orphelines",
            "expression": "COALESCE(COUNTROWS(Orphelins), 0)",
            "formatString": "#,0",
            "displayFolder": "Orphelins - source complete",
            "description": "",
            "lineageTag": "c1b6aa76-08f6-5555-b5b7-60dfea41df09"
          },
          {
            "name": "Montant orphelin",
            "expression": "SUM(Orphelins[ClaimAmount])",
            "formatString": "#,0.00 \"€\"",
            "displayFolder": "Orphelins - source complete",
            "description": "",
            "lineageTag": "b9d95808-117e-5002-9994-b79f33431efe"
          },
          {
            "name": "Priorite exploration",
            "expression": "IF([Nombre de contrats] >= 10000 && [Exposition annees] >= 1000 && [Frequence pour 100 annees] >= 1.2 * [Frequence portefeuille], \"À approfondir\", \"\")",
            "formatString": "",
            "displayFolder": "Exploration",
            "description": "Critères exploratoires : 10000 contrats, 1000 années et fréquence +20% par rapport au portefeuille. Pas un test statistique.",
            "lineageTag": "05b5b87c-4a85-5555-b2d6-02a4c8664aec"
          },
          {
            "name": "Frequence affichable",
            "expression": "IF([Exposition annees] >= 1000, [Frequence pour 100 annees])",
            "formatString": "0.00",
            "displayFolder": "Exploration",
            "description": "Masque uniquement la fréquence du visuel sous 1000 années d’exposition ; les contrats restent dans le modèle.",
            "lineageTag": "0a465d59-e265-5c88-b9fb-91997f339f36"
          },
          {
            "name": "Frequence age bonus",
            "expression": "IF([Nombre de contrats] >= 1000 && [Exposition annees] >= 500, [Frequence pour 100 annees])",
            "formatString": "0.00",
            "displayFolder": "Exploration",
            "description": "Affichage des sous-groupes avec au moins 1000 contrats et 500 années. Seuils de lecture, pas un test.",
            "lineageTag": "612b4860-8990-5c0d-bc28-953fbade398f"
          },
          {
            "name": "Rang region sinistres",
            "expression": "RANKX(ALLSELECTED(Contrats[Region]), [Sinistres declares], , DESC, DENSE)",
            "formatString": "#,0",
            "displayFolder": "Exploration",
            "description": "",
            "lineageTag": "7368aa75-e6ac-58bc-9f20-adce0e1addc4"
          }
        ]
      },
      {
        "name": "Sinistres",
        "lineageTag": "2f47de73-3942-5f2a-ab62-641b9cf790cc",
        "description": "Une ligne par sinistre observé de sev rapproché. Montants incomplets ; répétitions conservées.",
        "columns": [
