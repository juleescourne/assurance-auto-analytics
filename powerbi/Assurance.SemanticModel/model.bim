                "    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Types = Table.TransformColumnTypes(Entetes, {{\"LigneSource\", Int64.Type}, {\"IDpol\", Int64.Type}, {\"ClaimAmount\", type number}}, \"en-US\")",
                "in",
