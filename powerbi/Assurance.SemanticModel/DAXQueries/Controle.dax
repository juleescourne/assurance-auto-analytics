// Exécuter après Actualiser, dans la vue Requête DAX.
// Résultats attendus : voir ../../../data/processed/controle_kpi.csv.
// Les parts DAX sont des fractions : 0,2676 correspond à 26,76 %.
// Le CSV stocke ce pourcentage après multiplication par 100.
EVALUATE
ROW(
    "Contrats", [Nombre de contrats],
    "Exposition", [Exposition annees],
    "Sinistres declares", [Sinistres declares],
    "Sinistres observes", [Sinistres observes],
    "Montant observe", [Montant observe],
    "Frequence pour 100 annees", [Frequence pour 100 annees],
    "Cout moyen", [Cout moyen observe],
    "Mediane", [Cout median observe],
    "Part sans montant", [Part sans montant],
    "Contrats orphelins", [Contrats orphelins],
    "Lignes orphelines", [Lignes orphelines],
    "Montant orphelin", [Montant orphelin]
)

// Contrôle du filtre B12 / véhicule de 0 an : 37 069 contrats ; 4 318 sinistres ; fréquence 45,16 ; sans montant 87,10 %.
EVALUATE
CALCULATETABLE(
    ROW("Contrats", [Nombre de contrats], "Sinistres", [Sinistres declares],
        "Frequence", [Frequence pour 100 annees], "Sans montant", [Part sans montant]),
    Contrats[VehBrand] = "B12", Contrats[VehAge] = 0
)
